# DOMAIN
DOMAIN_NAME=oklimov.42.fr

# WORDPRESS DATABASE
WORDPRESS_DB_HOST=mariadb:3306
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wp_user
WORDPRESS_DB_PASSWORD=/run/secrets/wp_db_password

# WORDPRESS ADMIN (пароль у secrets)
WP_ADMIN_USER=superadmin
WP_ADMIN_EMAIL=admin@example.com
WP_ADMIN_PASSWORD_FILE=/run/secrets/wp_admin_password

# WORDPRESS SECOND USER (вимагає subject)
WP_USER=author
WP_USER_EMAIL=author@example.com
WP_USER_PASSWORD=author123

# MARIADB
MYSQL_DATABASE=wordpress
MYSQL_USER=wp_user
MYSQL_PASSWORD_FILE=/run/secrets/db_password
MYSQL_ROOT_PASSWORD_FILE=/run/secrets/db_root_password

# PATH FOR VOLUMES (передається з Makefile)
DATA_PATH=/home/oklimov/data
NETWORK_NAME=inception_network
RESTART_POLICY=always
